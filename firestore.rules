rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /production_entries/{entryId} {
      allow read, write: if true;
    }
    match /ledger_records/{recordId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /order_plans/{planId} {
      allow read, write: if true;
    }
    match /yarn_allocations/{yarnId} {
      allow read, write: if true;
    }
    match /yarn_allocations_store/{docId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /activity_logs/{logId} {
      allow read, write: if true;
    }
    match /sync_conflicts/{conflictId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

